# ============================================================================
# 环境配置示例
# 将本文件复制为 .env 后，按实际部署环境填写密钥。请勿把真实密钥提交到仓库。
# 服务启动时同名变量仅以首次出现的值为准，因此每个变量只应保留一份。
# ============================================================================

# ----------------------------------------------------------------------------
# 一、服务与后台管理
# ----------------------------------------------------------------------------
# HTTP 服务监听端口。生产环境通常由反向代理对外提供 HTTPS。
PORT=3000

# 后台管理账号。部署前务必修改默认密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now

# ----------------------------------------------------------------------------
# 二、图像生成服务：全局策略与默认模型
# ----------------------------------------------------------------------------
# 默认供应商 ID，必须包含在 IMAGE_API_PROVIDERS 列表中。
IMAGE_API_PROVIDER=kuaipao_grok
# 供应商优先级与前台下拉选项，使用英文逗号分隔；从左到右依次尝试。
IMAGE_API_PROVIDERS=kuaipao_grok,kuaipao,duckcoding
# 失败切换策略：auto 为自动切换可用供应商；off 为不自动切换。
IMAGE_API_FAILOVER_MODE=auto

# 单次图片生成请求的最长等待时间，单位毫秒。1800000 表示 30 分钟。
KUAIPAO_IMAGE_TIMEOUT_MS=1800000

# 未在供应商配置中单独指定时使用的 OpenAI 兼容默认值。
# OPENAI_API_KEY 也会作为旧版单供应商配置的兜底密钥。
OPENAI_API_KEY=your_openai_api_key_here
# 默认文生图模型名称。
OPENAI_IMAGE_MODEL=gpt-image-2
# 默认视觉识别/参考图理解模型名称。
OPENAI_VISION_MODEL=gpt-5.4-mini

# ----------------------------------------------------------------------------
# 三、图像生成服务：供应商配置
# 每个供应商均使用 IMAGE_API_<供应商 ID>_<字段> 格式。
# 字段说明：NAME 为界面显示名；BASE_URL 为 OpenAI 兼容接口根地址；
# KEY 为密钥；MODEL 为生图模型；VISION_MODEL 为视觉模型；
# ROUTE 可为 images、chat_completions 或 responses（未填写时默认 images）；
# ENABLED 用于启用或停用供应商。
# ----------------------------------------------------------------------------

# 3.1 快跑：标准图像生成服务。
IMAGE_API_KUAIPAO_NAME=快跑
IMAGE_API_KUAIPAO_BASE_URL=https://kuaipao.pro/v1
IMAGE_API_KUAIPAO_KEY=your_kuaipao_api_key_here
IMAGE_API_KUAIPAO_MODEL=gpt-image-2
IMAGE_API_KUAIPAO_ENABLED=true
IMAGE_API_KUAIPAO_VISION_MODEL=gpt-5.4-mini

# 3.2 Kuaipao Grok Image：通过 responses 路由调用的模型。
IMAGE_API_KUAIPAO_GROK_NAME=Kuaipao Grok Image
IMAGE_API_KUAIPAO_GROK_BASE_URL=https://kuaipao.pro/v1
IMAGE_API_KUAIPAO_GROK_KEY=your_kuaipao_api_key_here
IMAGE_API_KUAIPAO_GROK_MODEL=grok-image
IMAGE_API_KUAIPAO_GROK_ROUTE=responses
IMAGE_API_KUAIPAO_GROK_ENABLED=true
IMAGE_API_KUAIPAO_GROK_VISION_MODEL=gpt-5.4-mini

# 3.3 Kuaipao Nano Banana 2：通过 chat/completions 路由调用的模型。
IMAGE_API_KUAIPAO_NANO2_NAME=Kuaipao Nano Banana 2
IMAGE_API_KUAIPAO_NANO2_BASE_URL=https://kuaipao.pro/v1
IMAGE_API_KUAIPAO_NANO2_KEY=your_kuaipao_nano2_api_key_here
IMAGE_API_KUAIPAO_NANO2_MODEL=nano-banana-2
IMAGE_API_KUAIPAO_NANO2_ROUTE=chat_completions
IMAGE_API_KUAIPAO_NANO2_ENABLED=true
IMAGE_API_KUAIPAO_NANO2_VISION_MODEL=gpt-5.4-mini

# 3.4 DuckCoding：备用 OpenAI 兼容图像服务。
IMAGE_API_DUCKCODING_NAME=DuckCoding
IMAGE_API_DUCKCODING_BASE_URL=https://api.duckcoding.ai/v1
IMAGE_API_DUCKCODING_KEY=your_duckcoding_api_key_here
IMAGE_API_DUCKCODING_MODEL=gpt-image-2
IMAGE_API_DUCKCODING_ENABLED=true
IMAGE_API_DUCKCODING_VISION_MODEL=gpt-5.4-mini

# 可选：为视觉识别单独指定供应商链。未设置时复用 IMAGE_API_PROVIDER /
# IMAGE_API_PROVIDERS。若启用，请按 IMAGE_API_<供应商 ID>_* 的同样规则填写。
# VISION_API_PROVIDER=kuaipao
# VISION_API_PROVIDERS=kuaipao,duckcoding
# VISION_API_KUAIPAO_BASE_URL=https://kuaipao.pro/v1
# VISION_API_KUAIPAO_KEY=your_kuaipao_api_key_here
# VISION_API_KUAIPAO_MODEL=gpt-5.4-mini

# ----------------------------------------------------------------------------
# 四、宝宝认知书
# ----------------------------------------------------------------------------
# 生成模式：mock 为本地模拟、不调用真实模型；live 为调用已配置的生图服务。
BODY_BOOK_GENERATION_MODE=mock
# 是否为认知书生成扣除点数：true 开启，false 关闭。
BODY_BOOK_BILLING_ENABLED=false

# ----------------------------------------------------------------------------
# 五、支付与微信网页授权（当前可不启用）
# 项目默认使用商户收款码与管理员人工确认。只有重新启用自动微信支付时，
# 才需要完整填写 WECHAT_PAY_* 与 WECHAT_OAUTH_*；私钥支持使用 \n 表示换行。
# ----------------------------------------------------------------------------
# 微信支付/公众号 AppID。
WECHAT_PAY_APP_ID=
# 微信支付商户号。
WECHAT_PAY_MCH_ID=
# 商户 API v3 密钥（32 位）。
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号。
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥 PEM 内容。
WECHAT_PAY_PRIVATE_KEY=
# 微信支付平台证书公钥 PEM 内容，用于验签。
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# 微信支付异步通知地址，必须可由微信服务器访问。
WECHAT_PAY_NOTIFY_URL=
# 微信支付授权回调地址，必须与微信后台配置一致。
WECHAT_OAUTH_REDIRECT_URL=
# 微信网页授权 AppSecret。
WECHAT_OAUTH_APP_SECRET=
# OAuth state 签名密钥；留空时会回退使用 WECHAT_OAUTH_APP_SECRET，生产建议单独设置。
WECHAT_OAUTH_STATE_SECRET=
# 仅本地联调可设为 true，跳过真实支付流程；生产环境必须为 false。
LOCAL_MOCK_PAYMENT=false

# ----------------------------------------------------------------------------
# 六、邮箱验证码与腾讯云 SES
# EMAIL_CODE_LOG_ONLY=true 时，验证码会写入服务端日志并出现在接口响应中，
# 仅供本地调试，禁止在公网或生产环境启用。
# ----------------------------------------------------------------------------
EMAIL_CODE_LOG_ONLY=false
# 验证码哈希密钥；生产环境应设置为不与其他服务复用的随机长字符串。
EMAIL_CODE_SECRET=

# 腾讯云 CAM 访问密钥：建议使用仅具备 SES 发送权限的子账号。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 腾讯云 SES 所在地域，需与 SES 控制台配置保持一致。
TENCENTCLOUD_SES_REGION=ap-guangzhou
# 已在 SES 中验证通过的发信邮箱地址。
TENCENTCLOUD_SES_FROM_EMAIL=
# SES 已审核邮件模板的数字 ID；模板需包含 code 和 minutes 变量。
TENCENTCLOUD_SES_TEMPLATE_ID=
