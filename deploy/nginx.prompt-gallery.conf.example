server {
  listen 80;
  listen [::]:80;
  server_name your-domain.com www.your-domain.com api.your-domain.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name your-domain.com www.your-domain.com api.your-domain.com;

  # Must be present on the HTTPS server block used by the mini program's
  # imageApiBaseUrl domain, otherwise wx.uploadFile can fail with HTTP 413.
  client_max_body_size 40m;

  ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location /style-previews/ {
    alias /srv/prompt-gallery/public/style-previews/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location /images-small/ {
    alias /srv/prompt-gallery/wechat-miniprogram/miniprogram/images-small/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location /generated-images/ {
    alias /srv/prompt-gallery/public/generated-images/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location /generated-thumbnails/ {
    alias /srv/prompt-gallery/public/generated-thumbnails/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location /job-references/ {
    alias /srv/prompt-gallery/public/job-references/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location /job-reference-thumbnails/ {
    alias /srv/prompt-gallery/public/job-reference-thumbnails/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location = /manage {
    auth_basic "Prompt Gallery Manage";
    auth_basic_user_file /etc/nginx/.prompt-gallery-manage.htpasswd;
    proxy_pass http://127.0.0.1:3000;
  }

  location = /api/sync-miniprogram {
    auth_basic "Prompt Gallery Manage";
    auth_basic_user_file /etc/nginx/.prompt-gallery-manage.htpasswd;
    proxy_pass http://127.0.0.1:3000;
  }

  location = /api/styles {
    limit_except GET {
      auth_basic "Prompt Gallery Manage";
      auth_basic_user_file /etc/nginx/.prompt-gallery-manage.htpasswd;
    }
    proxy_pass http://127.0.0.1:3000;
  }

  location ~ ^/api/styles/ {
    auth_basic "Prompt Gallery Manage";
    auth_basic_user_file /etc/nginx/.prompt-gallery-manage.htpasswd;
    proxy_pass http://127.0.0.1:3000;
  }

  location = /api/style-groups {
    limit_except GET {
      auth_basic "Prompt Gallery Manage";
      auth_basic_user_file /etc/nginx/.prompt-gallery-manage.htpasswd;
    }
    proxy_pass http://127.0.0.1:3000;
  }

  location ~ ^/api/style-groups/ {
    auth_basic "Prompt Gallery Manage";
    auth_basic_user_file /etc/nginx/.prompt-gallery-manage.htpasswd;
    proxy_pass http://127.0.0.1:3000;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
  }
}
