<view class="page orders-page">
  <view class="content">
    <view class="orders-header">
      <text class="kicker">My orders</text>
      <text class="title">我的订单</text>
      <text class="subtitle">查看你的冰箱贴订单、购买币记录与处理状态。</text>
    </view>

    <view class="orders-note" wx:if="{{isLoading}}">正在读取订单列表…</view>
    <view class="orders-note error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="orders-note empty" wx:if="{{!isLoading && !errorMessage && !listItems.length}}">你还没有冰箱贴订单或购买币记录。</view>

    <view class="order-list" wx:if="{{listItems.length}}">
      <view wx:for="{{listItems}}" wx:key="key" class="order-card {{item.type === 'coin_purchase' ? 'coin-purchase-card' : ''}}">
        <block wx:if="{{item.type === 'coin_purchase'}}">
          <view bindtap="openCoinPurchase" class="order-card-open">
            <view class="order-cover coin-purchase-cover">币</view>
            <view class="order-summary">
              <text class="order-price">购买 {{item.coinCount}} 币</text>
              <text class="order-no">购买单号 {{item.purchaseNo}}</text>
              <text class="status {{item.statusClass}}">{{item.statusText}}</text>
            </view>
            <view class="order-actions order-actions-side">
              <button catchtap="payCoinPurchase" class="order-pay-button" data-id="{{item.id}}" loading="{{payingPurchaseId === item.id}}" disabled="{{payingPurchaseId === item.id}}" wx:if="{{item.canPay}}">支付</button>
              <button catchtap="deleteCoinPurchase" class="order-cancel-button" data-id="{{item.id}}" wx:if="{{item.canDelete}}">删除</button>
            </view>
          </view>
          <text class="coin-purchase-amount">{{item.amountText}}</text>
        </block>

        <block wx:else>
          <view bindtap="openOrder" class="order-card-open" data-id="{{item.id}}">
            <image class="order-cover" mode="aspectFill" src="{{item.imageUrl}}" wx:if="{{item.imageUrl}}" />
            <view class="order-cover empty" wx:else>冰箱贴</view>
            <view class="order-summary">
              <text class="order-price">{{item.totalText}}</text>
              <text class="order-no">订单号 {{item.orderNo}}</text>
              <text class="status {{item.statusClass}}">{{item.statusText}}</text>
            </view>
            <view class="order-actions order-actions-side">
              <button catchtap="deleteOrder" class="order-cancel-button" data-id="{{item.id}}" wx:if="{{item.canDelete}}">删除</button>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
