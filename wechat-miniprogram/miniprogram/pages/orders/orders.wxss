.orders-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 0%, rgba(197, 162, 117, 0.18), transparent 34%),
    linear-gradient(180deg, #0f1012 0%, #17181c 44%, #111214 100%);
  color: #f3ede1;
}

.content {
  box-sizing: border-box;
  width: 100%;
  max-width: 900rpx;
  margin: 0 auto;
  padding: 42rpx 22rpx 64rpx;
}

.orders-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.kicker {
  color: #c6a26d;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: #faf5eb;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 68rpx;
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1;
}

.subtitle {
  display: block;
  margin-top: 22rpx;
  color: rgba(235, 227, 214, 0.82);
  font-size: 28rpx;
  line-height: 1.65;
}

.orders-home-button,
.order-detail-button,
.order-cancel-button {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  border: 2rpx solid rgba(239, 225, 198, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #f3ede1;
  font-size: 25rpx;
  font-weight: 900;
}

.orders-home-button::after,
.order-detail-button::after,
.order-cancel-button::after {
  border: 0;
}

.orders-home-button {
  min-height: 82rpx;
  margin-top: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.orders-note {
  margin-top: 38rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(239, 225, 198, 0.12);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
  color: rgba(243, 237, 225, 0.76);
  font-size: 26rpx;
  line-height: 1.6;
}

.orders-note.error {
  border-color: rgba(230, 132, 122, 0.36);
  color: #ffc8c0;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 38rpx;
}

.order-card {
  padding: 22rpx;
  border: 2rpx solid rgba(239, 225, 198, 0.16);
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)),
    rgba(18, 19, 22, 0.78);
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.22);
}

.order-card-open {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.order-cover {
  flex: 0 0 auto;
  width: 138rpx;
  height: 138rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
}

.order-cover.empty,
.coin-purchase-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f3ede1;
  font-size: 25rpx;
  font-weight: 900;
}

.coin-purchase-cover {
  background: linear-gradient(135deg, #f0d5a0, #b98749);
  color: #171719;
  font-size: 46rpx;
}

.order-summary {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-width: 0;
  padding-top: 4rpx;
}

.order-price {
  color: #ffe0a3;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
}

.order-no {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(243, 237, 225, 0.65);
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  align-self: flex-start;
  min-height: 46rpx;
  margin-top: 12rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #e1f3c7;
  color: #2c6c2c;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.status.pending_payment {
  background: #fff0ca;
  color: #99631c;
}

.status.cancelled,
.status.expired {
  background: #f7d8d3;
  color: #9f302b;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.order-detail-button,
.order-cancel-button {
  min-height: 70rpx;
  padding: 0 22rpx;
}

.order-cancel-button {
  border-color: rgba(239, 142, 132, 0.4);
  color: #ffc2ba;
}

.coin-purchase-card {
  position: relative;
}

.coin-purchase-amount {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  color: rgba(243, 237, 225, 0.72);
  font-size: 25rpx;
  font-weight: 800;
}
