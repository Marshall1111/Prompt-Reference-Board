<view class="page">
  <view class="content">
    <view class="hero">
      <view class="hero-copy">
        <text class="eyebrow">Prompt Gallery</text>
        <text class="title">Choose a style and start generating</text>
        <text class="subtitle">Search styles, copy prompts, open the generator, or jump straight to your task list.</text>
      </view>
      <view class="hero-actions">
        <button bindtap="openBatch" class="batch-button">Batch Generate</button>
        <button bindtap="openTasks" class="tasks-button">Task List</button>
      </view>
    </view>

    <view class="search-card">
      <view class="search-row">
        <input bindinput="onSearchInput" class="search-input" confirm-type="search" placeholder="Search tags or prompt keywords" value="{{query}}" />
        <button bindtap="clearSearch" class="clear-button" wx:if="{{query}}">Clear</button>
      </view>
      <view class="stats-row">
        <text class="stat-text">Total {{totalCount}}</text>
        <text class="stat-dot">|</text>
        <text class="stat-text">Showing {{visibleCount}}</text>
      </view>
    </view>

    <view class="notice" wx:if="{{isLoading}}">Loading styles...</view>
    <view class="notice error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="notice" wx:if="{{!isLoading && !errorMessage && !visibleStyles.length}}">No matching styles. Try another keyword.</view>

    <view class="style-list" wx:if="{{visibleStyles.length}}">
      <view wx:for="{{visibleStyles}}" wx:key="id" class="style-card">
        <image bindtap="previewStyleImage" class="style-image" data-url="{{item.image}}" mode="aspectFill" src="{{item.image}}" wx:if="{{item.image}}" />
        <view class="style-body">
          <view class="badge-row">
            <text class="badge">{{index + 1}}</text>
            <text class="badge accent" wx:if="{{item.useStyleImageAsReference}}">Auto Ref 1</text>
          </view>

          <text class="style-title">{{item.title}}</text>

          <view class="tag-row" wx:if="{{item.tags.length}}">
            <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
          </view>

          <text class="prompt-preview">{{item.promptPreview}}</text>

          <view class="action-row">
            <button bindtap="copyPrompt" class="ghost-button half-button" data-id="{{item.id}}" data-prompt="{{item.prompt}}">
              {{copiedStyleId === item.id ? 'Copied' : 'Copy Prompt'}}
            </button>
            <button bindtap="openPromptModal" class="ghost-button half-button" data-prompt="{{item.prompt}}" data-title="{{item.title}}">View Prompt</button>
            <button bindtap="openGenerate" class="primary-button full-button" data-id="{{item.id}}">Generate With This Style</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view bindtap="closePromptModal" class="modal-mask" wx:if="{{promptModalVisible}}">
    <view catchtap="noop" class="modal-card">
      <text class="modal-title">{{activePromptTitle}}</text>
      <scroll-view class="modal-scroll" scroll-y>
        <text class="modal-text">{{activePrompt}}</text>
      </scroll-view>
      <view class="modal-actions">
        <button bindtap="copyActivePrompt" class="ghost-button half-button">Copy Prompt</button>
        <button bindtap="closePromptModal" class="primary-button half-button">Close</button>
      </view>
    </view>
  </view>
</view>
