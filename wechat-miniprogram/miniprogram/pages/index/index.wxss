.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(202, 119, 67, 0.14), transparent 32%),
    linear-gradient(180deg, #fff9f2 0%, #f4eee4 52%, #efe6db 100%);
}

.content {
  padding: 28rpx 22rpx 40rpx;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  display: block;
  color: #b45d3d;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #241c18;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.14;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #6d5d55;
  font-size: 24rpx;
  line-height: 1.7;
}

.tasks-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 170rpx;
  min-height: 84rpx;
  padding: 12rpx 22rpx;
  border-radius: 20rpx;
  background: #2c2019;
  color: #fff8f2;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.search-card,
.style-card,
.notice,
.modal-card {
  border: 2rpx solid rgba(92, 75, 62, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 252, 247, 0.94);
  box-shadow: 0 18rpx 40rpx rgba(65, 45, 28, 0.08);
}

.search-card {
  margin-top: 24rpx;
  padding: 20rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 22rpx;
  border: 2rpx solid #ead9cd;
  border-radius: 18rpx;
  background: #fffaf6;
  color: #2b2320;
  font-size: 28rpx;
}

.clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 124rpx;
  min-height: 84rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: #fff1e7;
  color: #8a4b2f;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.stat-text,
.stat-dot {
  color: #7a6a63;
  font-size: 22rpx;
}

.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  color: #64564f;
  font-size: 28rpx;
  line-height: 1.6;
}

.notice.error {
  background: #fdeceb;
  color: #a63f37;
}

.style-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.style-card {
  overflow: hidden;
}

.style-image {
  width: 100%;
  height: 420rpx;
  background: #eee4da;
}

.style-body {
  padding: 20rpx;
}

.badge-row,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.badge,
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.badge {
  background: #f1e6dc;
  color: #7e4b31;
}

.badge.accent {
  background: #f9dfc6;
  color: #8a4b2f;
}

.style-title {
  display: block;
  margin-top: 14rpx;
  color: #241c18;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.tag-row {
  margin-top: 14rpx;
}

.tag {
  background: #f6e1d4;
  color: #8a462b;
}

.prompt-preview {
  display: block;
  margin-top: 16rpx;
  color: #54453e;
  font-size: 24rpx;
  line-height: 1.7;
}

.action-row,
.modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ghost-button,
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  white-space: normal;
}

.ghost-button {
  background: #fff7f1;
  color: #7c523a;
  border: 2rpx solid #e5d3c6;
}

.primary-button {
  background: linear-gradient(135deg, #cc6b44, #9f3f34);
  color: #fff8f2;
}

.half-button {
  flex: 1 1 48%;
  min-width: 0;
}

.full-button {
  flex: 1 1 100%;
  width: 100%;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  background: rgba(22, 16, 13, 0.42);
}

.modal-card {
  width: 100%;
  max-height: 1200rpx;
  padding: 24rpx;
}

.modal-title {
  display: block;
  color: #241c18;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
}

.modal-scroll {
  height: 680rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff8f2;
}

.modal-text {
  color: #54453e;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
