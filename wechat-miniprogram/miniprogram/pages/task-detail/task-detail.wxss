.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffdf8 0%, #f6f1e8 100%);
}

.content {
  padding: 28rpx 22rpx 40rpx;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  display: block;
  color: #60706d;
  font-size: 24rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: #182022;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.05;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 156rpx;
  min-height: 76rpx;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #182022;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.summary-card,
.panel,
.error-card,
.loading-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #ded8ce;
  border-radius: 20rpx;
  background: rgba(255, 253, 249, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(33, 38, 40, 0.08);
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.status {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ed;
  color: #32413c;
  font-size: 22rpx;
  font-weight: 900;
}

.status.queued,
.status.running {
  background: #fff2e1;
  color: #9a5b1f;
}

.status.succeeded {
  background: #e7f5ee;
  color: #1f7a49;
}

.status.failed,
.status.cancelled {
  background: #fdeceb;
  color: #a63f37;
}

.meta,
.message,
.reference-name,
.loading-card,
.error-card,
.helper-text,
.notice-text,
.empty-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
}

.meta,
.reference-name,
.loading-card,
.helper-text,
.empty-text {
  color: #60706d;
}

.message {
  margin-top: 10rpx;
  color: #2c3432;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #4f4038;
  font-size: 24rpx;
  font-weight: 800;
}

.prompt-input {
  width: 100%;
  min-height: 240rpx;
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #ead9cd;
  border-radius: 20rpx;
  background: #fffaf6;
  color: #263532;
  font-size: 28rpx;
  line-height: 1.7;
}

.helper-text {
  margin-bottom: 12rpx;
}

.notice-text {
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #fff1e2;
  color: #8a4b2f;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-row.single {
  display: block;
}

.reference-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.reference-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1 1 calc(50% - 7rpx);
  min-width: 0;
}

.reference-image,
.result-image {
  width: 100%;
  overflow: hidden;
  border-radius: 18rpx;
  background: #efe5dc;
}

.reference-image {
  height: 220rpx;
}

.reference-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d7f74;
  font-size: 24rpx;
}

.ghost-button,
.primary-button,
.secondary-button,
.reference-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
  word-break: keep-all;
  text-align: center;
}

.ghost-button,
.primary-button,
.secondary-button {
  flex: 1 1 0;
}

.ghost-button {
  border: 2rpx solid #d6ddd8;
  background: #fffdf9;
  color: #32413c;
}

.primary-button {
  background: #115e59;
  color: #fff;
}

.secondary-button {
  background: #2c2019;
  color: #fff;
}

.reference-remove {
  min-height: 60rpx;
  background: #fff0eb;
  color: #a34737;
}

.single-button,
.action-row.single .primary-button {
  flex: none;
}

.reference-name {
  word-break: break-all;
}

.inline-error {
  margin-top: 24rpx;
}

.error-card {
  background: #fdeceb;
  color: #a63f37;
}
