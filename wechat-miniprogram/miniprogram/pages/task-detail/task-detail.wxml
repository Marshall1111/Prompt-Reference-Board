<view class="page">
  <view class="content" wx:if="{{job}}">
    <view class="header">
      <view class="header-copy">
        <text class="eyebrow">Job Detail</text>
        <text class="title">Task Detail</text>
      </view>
      <button bindtap="openTasks" class="back-button">Back</button>
    </view>

    <view class="summary-card">
      <view class="meta-row">
        <text class="status {{job.status}}">{{job.displayStatus}}</text>
        <text class="meta">{{job.modeText}}</text>
        <text class="meta">{{job.providerText}}</text>
      </view>
      <text class="meta" wx:if="{{job.styleNameText}}">Style: {{job.styleNameText}}</text>
      <text class="meta" wx:if="{{job.styleGroupNameText}}">Group: {{job.styleGroupNameText}}</text>
      <text class="meta">Size: {{job.sizeText}}</text>
      <text class="meta">Job ID: {{job.jobId}}</text>
      <text class="meta">Created: {{job.createdAtText}}</text>
      <text class="meta" wx:if="{{job.completedAtText}}">Done: {{job.completedAtText}}</text>
      <text class="meta" wx:if="{{job.durationText}}">Time: {{job.durationText}}</text>
      <text class="message" wx:if="{{job.message}}">{{job.message}}</text>
    </view>

    <view class="panel">
      <text class="field-label">Prompt</text>
      <textarea auto-height class="prompt-input" maxlength="-1" placeholder="Describe what to generate" value="{{prompt}}" bindinput="onPromptInput" />
      <view class="action-row">
        <button bindtap="copyPrompt" class="ghost-button">Copy Prompt</button>
        <button bindtap="regenerateJob" class="primary-button" loading="{{isRegenerating}}" disabled="{{isRegenerating}}">
          Regenerate
        </button>
      </view>
    </view>

    <view class="panel">
      <text class="field-label">Size</text>
      <picker bindchange="onSizeChange" range="{{sizeOptions}}" range-key="label" value="{{sizeIndex}}">
        <view class="picker-field">
          <text>{{sizeLabel}}</text>
          <text class="picker-meta">{{size}}</text>
        </view>
      </picker>
    </view>

    <view class="panel">
      <text class="field-label">References</text>
      <text class="helper-text">{{referenceHint}}</text>
      <text class="notice-text" wx:if="{{referenceNotice}}">{{referenceNotice}}</text>
      <text class="empty-text" wx:if="{{!referenceImages.length}}">No references selected.</text>

      <view class="reference-grid" wx:if="{{referenceImages.length}}">
        <view wx:for="{{referenceImages}}" wx:key="id" class="reference-card">
          <image bindtap="previewReference" class="reference-image" data-url="{{item.previewUrl}}" mode="aspectFill" src="{{item.renderUrl}}" wx:if="{{item.renderUrl}}" />
          <view class="reference-image reference-placeholder" wx:else>
            <text>No Preview</text>
          </view>
          <text class="reference-name">{{item.name}}</text>
          <button bindtap="removeReferenceImage" class="reference-remove" data-id="{{item.id}}">Remove</button>
        </view>
      </view>

      <view class="action-row" wx:if="{{referenceImages.length}}">
        <button bindtap="chooseReferenceImages" class="ghost-button" disabled="{{!canAddReference}}">Add More</button>
        <button bindtap="clearReferenceImages" class="secondary-button">Clear All</button>
      </view>
      <button bindtap="chooseReferenceImages" class="ghost-button single-button" wx:else>Choose References</button>
    </view>

    <view class="panel" wx:if="{{resultImageUrl}}">
      <text class="field-label">Result</text>
      <image bindtap="previewResult" class="result-image" mode="widthFix" src="{{resultImageUrl}}" />
      <view class="action-row single">
        <button bindtap="previewResult" class="primary-button">Preview</button>
      </view>
    </view>

    <view class="error-card inline-error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  </view>

  <view class="content" wx:elif="{{errorMessage}}">
    <view class="error-card">{{errorMessage}}</view>
  </view>

  <view class="content" wx:else>
    <view class="loading-card">Loading task detail...</view>
  </view>
</view>
