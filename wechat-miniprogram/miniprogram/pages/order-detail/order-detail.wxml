<view class="page">
  <view class="content">
    <view class="notice error" wx:if="{{errorMessage}}">{{errorMessage}}</view>

    <view wx:if="{{order}}">
      <view class="header">
        <view>
          <text class="kicker">Fridge order</text>
          <text class="title">{{order.orderNo}}</text>
        </view>
        <text class="status {{order.statusClass}}">{{order.statusText}}</text>
      </view>

      <button bindtap="copyContact" class="secondary-button full">联系客服</button>

      <view class="payment-card" wx:if="{{order.orderStatus === 'pending_payment'}}">
        <text class="card-title">请扫描商户收款码付款</text>
        <text>应付金额：{{order.totalText}}</text>
        <text>订单号：{{order.orderNo}}</text>
        <image class="merchant-payment-qr" mode="widthFix" src="../../images/wechat-merchant-collection.png" />
        <text class="payment-note">请按订单金额付款，转账备注填写订单号；管理员核验到账后会更新订单状态。</text>
        <text wx:if="{{order.expiresAtText}}">付款截止：{{order.expiresAtText}}</text>
        <view class="actions">
          <button bindtap="copyOrderNo" class="secondary-button">复制订单号</button>
        </view>
      </view>

      <view class="section-card">
        <text class="card-title">订单信息</text>
        <text>下单时间：{{order.createdAtText}}</text>
        <text>商品小计：{{order.subtotalText}}</text>
        <text>邮费：{{order.shippingText}}</text>
        <text class="total">合计：{{order.totalText}}</text>
      </view>

      <view class="section-card">
        <text class="card-title">收货信息</text>
        <text>{{order.receiverName}} · {{order.receiverPhone}}</text>
        <text>{{order.addressDetail}}</text>
        <text wx:if="{{order.remark}}">备注：{{order.remark}}</text>
      </view>

      <view class="item-grid">
        <view wx:for="{{order.items}}" wx:key="jobId" class="item-card">
          <image bindtap="previewItem" class="item-image" data-url="{{item.imageUrl}}" mode="aspectFill" src="{{item.thumbnailUrl || item.imageUrl}}" />
          <text>{{item.styleName || '冰箱贴'}}</text>
          <text class="meta">数量 x{{item.quantity}}</text>
        </view>
      </view>

      <button bindtap="cancelOrder" class="danger-button full" wx:if="{{order.canCancel}}">取消订单</button>
    </view>

    <view class="notice" wx:elif="{{!isLoading}}">订单不存在或已无法访问。</view>
  </view>
</view>
