@import "../common/public.wxss";

.merchant-payment-qr {
  width: 420rpx;
  margin: 18rpx auto;
  border: 2rpx solid #c9dcd6;
  border-radius: 16rpx;
  background: #fff;
}

.profile-setup-modal {
  width: 620rpx;
  max-width: calc(100vw - 64rpx);
}

.profile-setup-mask {
  align-items: center;
  padding: 32rpx;
}

.profile-avatar-picker {
  position: relative;
  display: flex;
  box-sizing: border-box;
  flex: 0 0 168rpx;
  align-items: center;
  justify-content: center;
  width: 168rpx !important;
  min-width: 168rpx;
  height: 168rpx !important;
  min-height: 168rpx !important;
  margin: 26rpx auto 22rpx;
  padding: 0;
  line-height: 1;
  overflow: hidden;
  border: 2rpx dashed rgba(239, 225, 198, 0.38);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  color: #f4e7cb;
}

.profile-avatar-picker::after {
  border: 0;
}

.profile-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 9rpx 0;
  background: rgba(17, 18, 22, 0.5);
  color: #fffaf0;
  font-size: 20rpx;
  line-height: 1.25;
}

.theme-fridge .profile-avatar-picker {
  border-color: #aec7ba;
  background: #fffefa;
  color: #34584d;
}
