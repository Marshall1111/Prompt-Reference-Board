<view class="page {{themeClass}} {{isDrawCard ? 'web-draw-page' : ''}}">
  <view class="content">
    <view class="utility-row" wx:if="{{showOtherEntry}}">
      <button bindtap="openOtherPage" class="utility-button">{{otherPageLabel}}</button>
    </view>

    <view class="hero">
      <text class="kicker" wx:if="{{titleKicker}}">{{titleKicker}}</text>
      <image class="draw-card-handwritten-title" mode="widthFix" src="https://www.petpaint.top/ui/ai-artist-title.png" wx:if="{{isDrawCard}}" />
      <text class="title" wx:else>{{title}}</text>
      <text class="subtitle">{{subtitle}}</text>
      <view class="draw-utility-bar" wx:if="{{isDrawCard}}">
        <button bindtap="openCoinInfo" class="draw-utility-coin"><text>余额</text><text class="draw-utility-coin-number">{{visitorState && visitorState.account ? visitorState.account.coinBalance : '--'}}</text><text>币</text></button>
        <view class="draw-user-area">
          <view bindtap="toggleAccountMenu" class="draw-account-button {{isAccountRegistered ? 'is-signed-in' : 'is-guest'}}" role="button">
            <image class="draw-account-avatar" mode="aspectFill" src="{{accountAvatarUrl}}" wx:if="{{isAccountRegistered && accountAvatarUrl}}" />
            <text wx:else>{{accountDisplayInitial}}</text>
          </view>
          <view class="draw-user-menu" wx:if="{{showUserMenu}}">
            <button bindtap="openOrdersFromUserMenu" class="draw-user-menu-button">我的订单</button>
            <button bindtap="openProfileSettingsFromUserMenu" class="draw-user-menu-button">用户信息</button>
          </view>
        </view>
      </view>
    </view>

    <view class="main-layout">
      <view class="main-column">
        <view class="upload-panel">
          <view bindtap="chooseImage" class="upload-box {{referencePreviewUrl ? 'has-image' : ''}}">
            <image class="upload-preview" mode="aspectFit" src="{{referencePreviewUrl}}" wx:if="{{referencePreviewUrl}}" />
            <view class="upload-empty" wx:else>
              <text class="upload-icon">+</text>
              <text class="upload-title">上传 1 张图片</text>
              <text class="upload-note">支持 JPG、PNG、WebP</text>
            </view>
          </view>

          <view class="action-row {{isDrawCard ? 'draw-home-actions' : ''}}">
            <button bindtap="openStylePicker" class="secondary-button" disabled="{{isSubmitting || isSessionInProgress}}" wx:if="{{isDrawCard}}">选择风格</button>
            <button bindtap="startDefault" class="primary-button draw-random-button" disabled="{{isSubmitting || isSessionInProgress}}">
              {{isSubmitting ? '任务启动中' : (isSessionInProgress ? '正在生成中' : (isDrawCard ? '随机抽卡' : startButtonText))}}
            </button>
            <button bindtap="clearImage" class="secondary-button" disabled="{{!referencePreviewUrl || isSubmitting}}" wx:if="{{!isDrawCard}}">换张图片</button>
          </view>
        </view>

        <view class="notice error" wx:if="{{errorMessage}}">{{errorMessage}}</view>

        <view class="status-panel" wx:if="{{phase === 'waiting' || phase === 'results' || phase === 'error'}}">
          <view class="status-head">
            <text class="status-title">{{phaseLabel}}</text>
            <text class="status-text">{{session.message || '请保持页面开启，结果会自动出现。'}}</text>
          </view>

          <view class="result-grid" wx:if="{{displayItems.length}}">
            <view wx:for="{{displayItems}}" wx:key="jobId" class="result-card {{item.canLike ? '' : 'is-pending'}}">
              <view bindtap="previewResult" class="result-media" data-url="{{item.imageUrl}}" data-jobid="{{item.jobId}}" wx:if="{{item.imageUrl}}">
                <image mode="widthFix" src="{{item.imageUrl}}" />
              </view>
              <view class="result-placeholder" wx:else>
                <text>{{item.statusLabel}}</text>
                <text wx:if="{{item.errorMessage}}">{{item.errorMessage}}</text>
              </view>
              <view class="result-meta">
                <text>{{item.styleName}}</text>
                <text class="status-chip">{{item.statusLabel}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="clip-panel">
        <view class="clip-head">
          <view>
            <text class="kicker">{{isDrawCard ? 'CARD CLIP' : 'Collection'}}</text>
            <text class="clip-title">{{clipTitle}}</text>
          </view>
          <text class="clip-count">{{clipItems.length}}</text>
        </view>

        <scroll-view class="draw-card-clip-strip" scroll-x="true" show-scrollbar="false" wx:if="{{isDrawCard && clipItems.length}}">
          <view wx:for="{{clipItems}}" wx:key="jobId" bindtap="previewClip" class="draw-card-clip-thumbnail" data-url="{{item.imageUrl || item.thumbnailUrl}}" data-jobid="{{item.jobId}}">
            <image class="draw-card-clip-image" mode="aspectFill" src="{{item.thumbnailUrl || item.imageUrl}}" />
            <view class="draw-card-acrylic-shine"></view>
            <view class="magnet-corner top-left"></view>
            <view class="magnet-corner top-right"></view>
            <view class="magnet-corner bottom-left"></view>
            <view class="magnet-corner bottom-right"></view>
          </view>
        </scroll-view>

        <view class="clip-list" wx:if="{{!isDrawCard && clipItems.length}}">
          <view wx:for="{{clipItems}}" wx:key="jobId" class="clip-item">
            <view bindtap="previewClip" class="clip-magnet-frame" data-url="{{item.imageUrl || item.thumbnailUrl}}" data-jobid="{{item.jobId}}">
              <image class="clip-image" mode="aspectFill" src="{{item.thumbnailUrl || item.imageUrl}}" />
              <view class="magnet-corner top-left"></view>
              <view class="magnet-corner top-right"></view>
              <view class="magnet-corner bottom-left"></view>
              <view class="magnet-corner bottom-right"></view>
            </view>
            <view class="clip-meta">
              <text>{{item.styleName || clipItemFallback}}</text>
              <view class="clip-item-actions">
                <button bindtap="downloadClipOriginal" class="mini-primary" data-jobid="{{item.jobId}}">{{visitorState && visitorState.account && visitorState.account.canRedeemOriginalDownloads ? '下载原图' : '解锁后下载'}}</button>
                <button bindtap="removeFromClip" class="mini-danger" data-jobid="{{item.jobId}}">{{pocketRemoveLabel}}</button>
              </view>
            </view>
          </view>
        </view>
        <view class="clip-empty" wx:if="{{!clipItems.length}}">{{clipEmptyText}}</view>

        <view class="draw-card-clip-order-row" wx:if="{{isDrawCard}}">
          <button bindtap="openOrderModal" class="draw-card-clip-order" disabled="{{!clipItems.length || !orderConfig || !orderConfig.enabled}}">
            <text>✦</text>
            <text>{{orderConfig && orderConfig.enabled ? '选图定制' : '定制暂未开放'}}</text>
          </button>
          <text class="draw-card-clip-order-price">冰箱贴 {{orderUnitPriceText}} / 枚</text>
        </view>

        <view class="account-panel" wx:if="{{!isDrawCard}}">
          <view class="account-summary">
            <text class="account-name">{{visitorState && visitorState.account ? visitorState.account.username : '微信用户'}}</text>
            <text class="account-access">{{visitorState && visitorState.account && visitorState.account.canRedeemOriginalDownloads ? '已解锁账户下全部原图下载' : '购买币累计满 20 元或完成定制订单可解锁原图下载'}}</text>
          </view>
          <text>账户币：{{visitorState && visitorState.account ? visitorState.account.coinBalance : '--'}}</text>
          <input bindinput="onInviteInput" class="inline-input" placeholder="输入兑换码" value="{{inviteCode}}" />
          <view class="clip-actions">
            <button bindtap="openCoinPurchase" class="secondary-button" wx:if="{{isDrawCard}}">购买币</button>
            <button bindtap="openOrderModal" class="primary-button" disabled="{{!clipItems.length || !orderConfig || !orderConfig.enabled}}" wx:if="{{isDrawCard}}">选图定制</button>
            <button bindtap="openOrders" class="secondary-button" wx:if="{{isDrawCard}}">我的订单</button>
            <button bindtap="redeemInvite" class="secondary-button">兑换</button>
            <button bindtap="copyContact" class="secondary-button">联系客服</button>
            <button bindtap="toggleAccountMenu" class="secondary-button">{{isAccountRegistered ? '账号菜单' : '登录 / 注册'}}</button>
          </view>
          <button bindtap="openOrderModal" class="primary-button order-entry" disabled="{{!clipItems.length || !orderConfig || !orderConfig.enabled}}" wx:if="{{isFridge}}">
            {{orderConfig && orderConfig.enabled ? '提交订单' : '下单未开放'}}
          </button>
          <button bindtap="openOrders" class="secondary-button order-entry" wx:if="{{isFridge}}">我的订单</button>
          <text class="contact-note">{{visitorState ? visitorState.contactMessage : contactFallback}}</text>
        </view>
      </view>
    </view>
  </view>

  <view bindtap="closeImagePreview" class="image-preview-mask" wx:if="{{showImagePreview}}">
    <view catchtap="stopTap" class="image-preview-panel">
      <image class="image-preview-image" mode="aspectFit" src="{{previewImageUrl}}" show-menu-by-longpress="{{previewIsOriginal}}" />
      <view class="image-preview-actions">
        <button bindtap="closeImagePreview" class="image-preview-back" disabled="{{isPreviewOriginalLoading || isPreviewClipUpdating}}">返回</button>
        <button bindtap="togglePreviewClip" class="image-preview-clip" loading="{{isPreviewClipUpdating}}" disabled="{{isPreviewOriginalLoading || isPreviewClipUpdating || !previewJobId}}">{{previewIsLiked ? '移出卡夹' : '加入卡夹'}}</button>
        <button bindtap="downloadPreviewOriginal" class="image-preview-download" loading="{{isPreviewOriginalLoading}}" disabled="{{isPreviewOriginalLoading || isPreviewClipUpdating || !previewJobId}}">下载原图</button>
      </view>
      <text class="image-preview-tip" wx:if="{{previewNeedsLongPress}}">请长按图片保存原图</text>
    </view>
  </view>

  <view bindtap="closeOriginalDownloadUnlock" class="original-unlock-mask" wx:if="{{showOriginalDownloadUnlock}}">
    <view catchtap="stopTap" class="original-unlock-card">
      <text class="original-unlock-title">解锁原图下载</text>
      <text class="original-unlock-text">购买币累计满 20 元，或完成任意冰箱贴定制订单支付后，即可下载本账户下的全部原图，无需额外消耗币。</text>
      <view class="original-unlock-actions">
        <button bindtap="openOriginalUnlockCoinPurchase" class="primary-button">购买币</button>
        <button bindtap="openOriginalUnlockOrder" class="secondary-button">选图定制</button>
      </view>
      <button bindtap="closeOriginalDownloadUnlock" class="original-unlock-dismiss">暂不解锁</button>
    </view>
  </view>

  <view class="orders-overlay" wx:if="{{showOrdersOverlay}}">
    <view class="orders-overlay-content">
      <button bindtap="closeOrdersOverlay" class="secondary-button orders-overlay-back">返回</button>
      <view class="orders-overlay-header">
        <text class="orders-overlay-kicker">My orders</text>
        <text class="orders-overlay-title">我的订单</text>
        <text class="orders-overlay-subtitle">查看你的冰箱贴订单、购买币记录与处理状态。</text>
      </view>

      <view class="orders-overlay-note" wx:if="{{isOrdersOverlayLoading}}">正在读取订单列表…</view>
      <view class="orders-overlay-note error" wx:if="{{ordersOverlayError}}">{{ordersOverlayError}}</view>
      <view class="orders-overlay-note" wx:if="{{!isOrdersOverlayLoading && !ordersOverlayError && !orderOverlayItems.length}}">你还没有冰箱贴订单或购买币记录。</view>

      <view class="orders-overlay-list" wx:if="{{orderOverlayItems.length}}">
        <view wx:for="{{orderOverlayItems}}" wx:key="key" class="orders-overlay-card {{item.type === 'coin_purchase' ? 'coin-purchase-card' : ''}}">
          <block wx:if="{{item.type === 'coin_purchase'}}">
            <view bindtap="openOverlayCoinPurchase" class="orders-overlay-card-row" data-id="{{item.id}}">
              <view class="orders-overlay-cover coin">币</view>
              <view class="orders-overlay-summary">
                <text class="orders-overlay-price">购买 {{item.coinCount}} 币</text>
                <text class="orders-overlay-no">购买单号 {{item.purchaseNo}}</text>
                <text class="orders-overlay-status {{item.statusClass}}">{{item.statusText}}</text>
              </view>
              <view class="orders-overlay-actions orders-overlay-actions-side">
                <button catchtap="payOverlayCoinPurchase" class="orders-overlay-pay" data-id="{{item.id}}" loading="{{payingOverlayPurchaseId === item.id}}" disabled="{{payingOverlayPurchaseId === item.id}}" wx:if="{{item.canPay}}">支付</button>
                <button catchtap="deleteOverlayCoinPurchase" class="orders-overlay-cancel" data-id="{{item.id}}" wx:if="{{item.canDelete}}">删除</button>
              </view>
            </view>
            <text class="orders-overlay-amount">{{item.amountText}}</text>
          </block>
          <block wx:else>
            <view bindtap="openOverlayOrder" class="orders-overlay-card-row" data-id="{{item.id}}">
              <image class="orders-overlay-cover" mode="aspectFill" src="{{item.imageUrl}}" wx:if="{{item.imageUrl}}" />
              <view class="orders-overlay-cover empty" wx:else>冰箱贴</view>
              <view class="orders-overlay-summary">
                <text class="orders-overlay-price">{{item.totalText}}</text>
                <text class="orders-overlay-no">订单号 {{item.orderNo}}</text>
                <text class="orders-overlay-status {{item.statusClass}}">{{item.statusText}}</text>
              </view>
              <view class="orders-overlay-actions orders-overlay-actions-side">
                <button catchtap="deleteOverlayOrder" class="orders-overlay-cancel" data-id="{{item.id}}" wx:if="{{item.canDelete}}">删除</button>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view bindtap="closeUserMenu" class="draw-user-menu-dismiss" wx:if="{{showUserMenu}}"></view>

  <view class="modal-mask" wx:if="{{showDrawConfig}}">
    <view class="modal-card">
      <text class="modal-title">设置本次抽卡</text>
      <text class="field-label">照片主体</text>
      <view class="segment-grid">
        <view wx:for="{{subjectOptions}}" wx:key="value" bindtap="selectSubject" class="segment {{selectedSubjectType === item.value ? 'active' : ''}}" data-value="{{item.value}}">{{item.label}}</view>
      </view>
      <text class="field-label top-gap">本次抽卡</text>
      <view class="count-grid">
        <view wx:for="{{drawCountOptions}}" wx:key="*this" bindtap="setDrawCount" class="segment {{requestedDrawCount === item ? 'active' : ''}}" data-count="{{item}}">{{item}}张</view>
      </view>
      <text class="modal-note">失败结果不扣点。</text>
      <view class="modal-actions">
        <button bindtap="closeDrawConfig" class="secondary-button">取消</button>
        <button bindtap="confirmDrawConfig" class="primary-button">确认抽卡</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showStylePicker}}">
    <view class="modal-card large">
      <text class="modal-title">自选风格</text>
      <text class="modal-note">最多选择 6 种风格。已选 {{selectedStyleIds.length}} / 6</text>
      <view class="notice error" wx:if="{{stylePickerError}}">{{stylePickerError}}</view>
      <scroll-view class="style-scroll" scroll-y>
        <view class="style-grid">
          <view wx:for="{{styles}}" wx:key="id" bindtap="toggleStyle" class="style-card {{item.selected ? 'active' : ''}}" data-id="{{item.id}}">
            <image class="style-image" mode="aspectFill" src="{{item.image}}" wx:if="{{item.image}}" />
            <view class="style-image empty-style" wx:else></view>
            <text>{{item.title}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="modal-actions">
        <button bindtap="closeStylePicker" class="secondary-button">取消</button>
        <button bindtap="confirmStylePicker" class="primary-button">开始生成</button>
      </view>
    </view>
  </view>

  <view class="modal-mask order-modal-mask" wx:if="{{showOrderModal}}">
    <view class="modal-card large order-modal-card">
      <text class="modal-title">填写收货信息</text>
      <view class="order-summary">
        <text>已选 {{orderSelectedImageCount}} 款，共 {{orderAmount.itemCount}} 只</text>
        <text>单价 {{orderUnitPriceText}} / 只</text>
        <text>邮费 {{orderShippingText}}</text>
        <text class="order-total">合计 {{orderAmountText}}</text>
      </view>
      <scroll-view class="order-scroll" scroll-y>
        <view class="order-item {{item.quantity === 0 ? 'is-not-selected' : ''}}" wx:for="{{orderItems}}" wx:key="jobId">
          <image class="order-image" mode="aspectFill" src="{{item.thumbnailUrl || item.imageUrl}}" />
          <view class="order-item-body">
            <text>{{item.styleName || '冰箱贴'}}</text>
            <text class="muted">{{item.subtotalText}}</text>
            <view class="stepper">
              <button bindtap="decreaseQuantity" data-jobid="{{item.jobId}}" disabled="{{item.quantity <= 0}}">-</button>
              <text>{{item.quantity}}</text>
              <button bindtap="increaseQuantity" data-jobid="{{item.jobId}}">+</button>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="form-grid">
        <input bindinput="onOrderFieldInput" class="form-input" data-field="receiverName" placeholder="收件人" value="{{orderForm.receiverName}}" />
        <input bindinput="onOrderFieldInput" class="form-input" data-field="receiverPhone" placeholder="手机号" type="number" value="{{orderForm.receiverPhone}}" />
        <input bindinput="onOrderFieldInput" class="form-input full" data-field="address" placeholder="收货地址" value="{{orderForm.address}}" />
        <textarea bindinput="onOrderFieldInput" class="form-textarea full" data-field="remark" placeholder="备注（选填）" value="{{orderForm.remark}}" />
      </view>
      <view class="notice error" wx:if="{{orderError}}">{{orderError}}</view>
      <view class="modal-actions">
        <button bindtap="closeOrderModal" class="secondary-button">取消</button>
        <button bindtap="submitOrder" class="primary-button" loading="{{isCreatingOrder}}" disabled="{{isCreatingOrder || !orderAmount.itemCount}}">提交订单</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showManualPayment}}">
    <view class="modal-card">
      <text class="modal-title">订单已创建</text>
      <view class="order-summary">
        <text>订单号：{{manualPaymentOrder.order.orderNo}}</text>
        <text>应付金额：{{orderAmountText}}</text>
        <image class="merchant-payment-qr" mode="widthFix" src="../../images/wechat-merchant-collection.png" />
        <text class="order-total">请扫描商户收款码并按订单金额付款，转账备注填写订单号；管理员核验到账后会更新订单状态。</text>
      </view>
      <view class="modal-actions vertical">
        <button bindtap="copyManualOrderNo" class="secondary-button">复制订单号</button>
        <button bindtap="viewManualOrder" class="primary-button">查看订单详情</button>
        <button bindtap="closeManualPayment" class="secondary-button">我知道了</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showAccountModal}}">
    <view class="modal-card large account-modal">
      <text class="modal-title">微信登录</text>
      <text class="modal-note">用于识别你的微信账户并同步生成结果、卡夹和订单。登录后可在“用户信息”中自行设置头像和昵称。</text>
      <view class="notice error" wx:if="{{authError}}">{{authError}}</view>
      <view class="notice success" wx:if="{{authMessage}}">{{authMessage}}</view>
      <view class="modal-actions vertical">
        <button bindtap="loginWithWechat" class="primary-button" loading="{{authBusy}}" disabled="{{authBusy}}">微信登录</button>
      </view>
    </view>
  </view>

  <view class="modal-mask profile-setup-mask" wx:if="{{showProfileSetup}}">
    <view class="modal-card profile-setup-modal">
      <text class="modal-title">用户信息</text>
      <text class="modal-note">默认头像和昵称已为你准备好，点击头像或昵称可自行修改。</text>
      <button class="profile-avatar-picker" open-type="chooseAvatar" bindchooseavatar="onProfileAvatarChosen" disabled="{{isSavingProfile}}">
        <image class="profile-avatar-preview" mode="aspectFill" src="{{profileAvatarPreviewUrl}}" />
        <text class="profile-avatar-action">更换头像</text>
      </button>
      <input bindinput="onProfileNicknameInput" class="form-input full" type="nickname" maxlength="80" placeholder="昵称" value="{{profileNickname}}" disabled="{{isSavingProfile}}" />
      <view class="notice error" wx:if="{{profileError}}">{{profileError}}</view>
      <view class="modal-actions profile-setup-actions">
        <button bindtap="closeProfileSettings" class="secondary-button" disabled="{{isSavingProfile}}">取消</button>
        <button bindtap="submitProfileSetup" class="primary-button" loading="{{isSavingProfile}}" disabled="{{isSavingProfile}}">保存修改</button>
      </view>
    </view>
  </view>

  <view bindtap="closeCoinInfo" class="modal-mask coin-info-mask" wx:if="{{showCoinInfo}}">
    <view catchtap="stopTap" class="modal-card large coin-info-modal">
      <button bindtap="closeCoinInfo" class="modal-close-button" aria-label="关闭">×</button>
      <text class="modal-eyebrow">My coins</text>
      <text class="modal-title">我的币</text>
      <text class="coin-info-balance">可用币：<text>{{visitorState && visitorState.account ? visitorState.account.coinBalance : '--'}}</text> 币</text>
      <text class="modal-note">冰箱贴优惠券：{{coinPurchaseDiscountText}}</text>
      <view class="coin-info-benefits">
        <view><text>•</text><text>购买币后，购买金额会自动变成等额的冰箱贴优惠券。</text></view>
        <view><text>•</text><text>下单时自动抵扣，每枚冰箱贴最多优惠 15 元；购买多枚可叠加使用。</text></view>
        <view><text>•</text><text>冰箱贴订单支付成功后，按抵扣后实付金额赠送等额币。</text></view>
        <view><text>•</text><text>邀请新用户完成首笔冰箱贴订单支付，可获得 5 币。</text></view>
      </view>
      <view class="modal-actions coin-info-actions">
        <button bindtap="openCoinPurchase" class="primary-button">购买币</button>
        <button bindtap="prepareReferralShare" class="secondary-button coin-referral-button" disabled="{{isPreparingReferral || !referralSharePath}}" open-type="share">{{isPreparingReferral ? '准备邀请中…' : '邀新获币'}}</button>
      </view>
      <text class="coin-info-error" wx:if="{{referralError}}">{{referralError}}</text>
      <text class="field-label">兑换码</text>
      <input bindinput="onInviteInput" class="form-input" placeholder="输入兑换码" value="{{inviteCode}}" />
      <button bindtap="redeemInvite" class="primary-button coin-redeem-button" disabled="{{!inviteCode}}">兑换</button>
    </view>
  </view>

  <view bindtap="closeCoinPurchase" class="modal-mask coin-purchase-mask" wx:if="{{showCoinPurchase}}">
    <view catchtap="stopTap" class="modal-card large coin-purchase-modal">
      <button bindtap="closeCoinPurchase" class="modal-close-button" disabled="{{isCoinPurchaseBusy}}" aria-label="关闭">×</button>
      <text class="modal-eyebrow">Buy coins</text>
      <text class="modal-title">购买币</text>
      <text class="coin-purchase-intro">{{coinPurchaseUnitPriceText}} = 1 币。成功购买的金额可抵扣冰箱贴商品金额，每枚冰箱贴最多抵扣 15 元；累计成功购买满 20 元可解锁账户下全部原图下载。</text>

      <view class="coin-purchase-presets">
        <button bindtap="selectCoinPurchaseCount" class="coin-purchase-preset" data-count="10" disabled="{{isCoinPurchaseBusy}}">10 币</button>
        <button bindtap="selectCoinPurchaseCount" class="coin-purchase-preset" data-count="20" disabled="{{isCoinPurchaseBusy}}">20 币</button>
        <button bindtap="selectCoinPurchaseCount" class="coin-purchase-preset" data-count="40" disabled="{{isCoinPurchaseBusy}}">40 币</button>
        <button bindtap="selectCoinPurchaseCount" class="coin-purchase-preset" data-count="100" disabled="{{isCoinPurchaseBusy}}">100 币</button>
      </view>

      <view class="coin-purchase-field">
        <text>购买数量（1–1000 币）</text>
        <input bindinput="onCoinPurchaseCountInput" class="coin-purchase-input" disabled="{{isCoinPurchaseBusy}}" maxlength="4" type="number" value="{{coinPurchaseCount}}" />
      </view>
      <text class="coin-purchase-payable">应付 <text>{{coinPurchaseAmountText}}</text></text>
      <text class="coin-purchase-discount-note">购买 {{coinPurchaseCount}} 币后，自动获得 {{coinPurchaseDiscountAmountText}} 实体冰箱贴优惠券，首枚定制仅需 {{coinPurchaseFirstMagnetPriceYuan}} 元。（每枚冰箱贴优惠上限 15 元）</text>
      <text class="coin-purchase-note">赠送币和兑换码兑换币不参与冰箱贴优惠抵扣。</text>
      <text class="coin-purchase-error" wx:if="{{coinPurchaseError}}">{{coinPurchaseError}}</text>

      <view class="coin-purchase-actions">
        <button bindtap="closeCoinPurchase" class="coin-purchase-cancel" disabled="{{isCoinPurchaseBusy}}">取消</button>
        <button bindtap="submitCoinPurchase" class="coin-purchase-pay" disabled="{{isCoinPurchaseBusy || !coinPurchaseCount}}" loading="{{isCoinPurchaseBusy}}">{{isCoinPurchaseBusy ? '处理中' : ('支付 ' + coinPurchaseAmountText)}}</button>
      </view>
    </view>
  </view>
</view>
