    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.025)),
    rgba(18, 19, 22, 0.76);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.web-draw-page .clip-panel {
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 24rpx;
}

.draw-card-clip-strip {
  width: 100%;
  white-space: nowrap;
}

.draw-card-clip-thumbnail {
  position: relative;
  display: inline-flex;
  width: 142rpx;
  height: 210rpx;
  box-sizing: border-box;
  margin-right: 14rpx;
  padding: 8rpx;
  overflow: hidden;
  vertical-align: top;
  border: 2rpx solid rgba(239, 248, 249, 0.86);
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.68), rgba(194, 221, 225, 0.24));
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.26), inset 0 2rpx 3rpx rgba(255, 255, 255, 0.94), inset 0 0 0 4rpx rgba(255, 255, 255, 0.14);
}

.draw-card-clip-image {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 7rpx;
}

.draw-card-acrylic-shine {
  position: absolute;
  z-index: 2;
  top: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  pointer-events: none;
  border-radius: 10rpx;
  background: linear-gradient(118deg, transparent 30%, rgba(255, 255, 255, 0.06) 39%, rgba(255, 255, 255, 0.68) 48%, rgba(255, 255, 255, 0.12) 57%, transparent 66%);
}

.draw-card-clip-thumbnail .magnet-corner {
  width: 15rpx;
  height: 15rpx;
  border-width: 2rpx;
}

.draw-card-clip-thumbnail .magnet-corner.top-left { top: 5rpx; left: 5rpx; }
.draw-card-clip-thumbnail .magnet-corner.top-right { top: 5rpx; right: 5rpx; }
.draw-card-clip-thumbnail .magnet-corner.bottom-left { bottom: 5rpx; left: 5rpx; }
.draw-card-clip-thumbnail .magnet-corner.bottom-right { right: 5rpx; bottom: 5rpx; }

.draw-card-clip-order-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 2rpx;
}

.draw-card-clip-order {
  box-sizing: border-box;
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid rgba(255, 216, 149, 0.6);
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(255, 216, 149, 0.3), rgba(255, 161, 150, 0.24));
  color: #fff1c7;
  font-size: 26rpx;
  font-weight: 900;
}

.draw-card-clip-order::after {
  border: 0;
}

.draw-card-clip-order[disabled] {
  opacity: 0.48;
}

.draw-card-clip-order-price {
  color: rgba(243, 237, 225, 0.72);
  font-size: 24rpx;
  font-weight: 800;
}

.web-draw-page .clip-item {
  border: 2rpx solid rgba(239, 225, 198, 0.1);
  background: rgba(255, 255, 255, 0.03);
}

.web-draw-page .account-panel {
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(239, 225, 198, 0.1);
}

@media (max-width: 560px) {
  .web-draw-page .content {
    padding-top: 30rpx;
  }
}
