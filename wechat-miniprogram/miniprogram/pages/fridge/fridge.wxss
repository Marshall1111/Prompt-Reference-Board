@import "../common/public.wxss";

.profile-setup-modal {
  width: 620rpx;
  max-width: calc(100vw - 64rpx);
}

.profile-setup-actions {
  flex-wrap: nowrap;
}

.profile-setup-actions .secondary-button,
.profile-setup-actions .primary-button {
  flex: 1 1 0;
  width: 0;
}

.profile-setup-mask {
  align-items: center;
  padding: 32rpx;
}

.profile-avatar-picker {
  position: relative;
  display: flex;
  box-sizing: border-box;
  flex: 0 0 168rpx;
  align-items: center;
  justify-content: center;
  width: 168rpx !important;
  min-width: 168rpx;
  height: 168rpx !important;
  min-height: 168rpx !important;
  margin: 26rpx auto 22rpx;
  padding: 0;
  line-height: 1;
  overflow: hidden;
  border: 2rpx dashed #aec7ba;
  border-radius: 50%;
  background: #fffefa;
  color: #34584d;
}

.profile-avatar-picker::after {
  border: 0;
}

.profile-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-avatar-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 9rpx 0;
  background: rgba(17, 18, 22, 0.5);
  color: #fffaf0;
  font-size: 20rpx;
  line-height: 1.25;
}
