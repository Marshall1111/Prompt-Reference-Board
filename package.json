{
  "name": "prompt-gallery-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test:custom-print": "node --test tests/custom-print.test.mjs",
    "test:custom-print:browser": "node tests/custom-print-browser.mjs",
    "test:custom-print:server": "node tests/custom-print-server.mjs",
    "backfill:thumbnails": "node tools/backfill-image-thumbnails.mjs",
    "backfill:style-previews": "node tools/backfill-style-publication-previews.mjs",
    "backfill:style-sorts": "node tools/backfill-style-publication-sort-orders.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.555.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-pageflip": "^2.0.3",
    "sharp": "^0.34.2",
    "tencentcloud-sdk-nodejs": "^4.1.271",
    "vite": "^7.2.5"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
